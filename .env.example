# Copy this file to .env and fill in the values. Never commit .env.

# --- Required ---------------------------------------------------------------

# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Recommended ------------------------------------------------------------

# Every note is sent to you in Telegram as a .md file and also kept in this folder.
# Point it inside your Obsidian vault if the bot runs on a machine that has the vault.
# Default when empty: a "notes" folder next to bot.py.
OBSIDIAN_VAULT_PATH=

# Only accept messages from these Telegram user ids (comma-separated).
# Send /start to the bot to learn your id. Leave empty to allow anyone.
TELEGRAM_ALLOWED_USER_IDS=

# --- Transcription backend -------------------------------------------------

# "local" runs faster-whisper on this machine (default, no extra account, slow on small CPUs).
# "api" uploads the audio to an OpenAI-compatible speech-to-text endpoint: a 10-minute video
# transcribes in well under a minute and the bot can run on the smallest server.
TRANSCRIBER=local
# STT_API_KEY=
# STT_BASE_URL=https://api.openai.com/v1      # or https://api.groq.com/openai/v1
# STT_MODEL=whisper-1                         # or whisper-large-v3-turbo on Groq

# --- Optional overrides (defaults shown) ------------------------------------

# CLAUDE_MODEL=claude-sonnet-5
# WHISPER_MODEL=distil-large-v3
# WHISPER_DEVICE=cpu            # "cuda" if you have an NVIDIA GPU with CUDA set up
# WHISPER_COMPUTE_TYPE=int8     # "float16" on GPU
# WHISPER_CPU_THREADS=0         # 0 = library default; set to your CPU core count to use every core
# WHISPER_BEAM_SIZE=5           # 1 is roughly 30% faster with slightly lower accuracy
# INCLUDE_TRANSCRIPT=true       # append the full timestamped transcript in a folded section at the end
# INCLUDE_FRAMES=true           # let Claude pick moments worth a screenshot and send them with the transcript
# CUE_MODEL=claude-sonnet-5     # model for that screenshot-selection pass (defaults to CLAUDE_MODEL)
# FRAMES_MAX=30                 # most screenshots sent to Claude per video
# FRAMES_VIDEO_HEIGHT=720       # resolution of the video stream downloaded for screenshots
# MAX_VIDEO_MINUTES=0           # refuse longer videos; 0 = no limit
# YTDLP_COOKIES_FILE=           # Netscape-format cookies.txt if YouTube asks you to sign in
